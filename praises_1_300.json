[
  {
    "id": 1,
    "tamil": "அப்பா பிதாவே ஸ்தோத்திரம்.",
    "ref": "ரோம. 8:15"
  },
  {
    "id": 2,
    "tamil": "அன்பின் பிதாவே ஸ்தோத்திரம்.",
    "ref": "1 யோவா. 3:1"
  },
  {
    "id": 3,
    "tamil": "அன்பின் குமாரனே ஸ்தோத்திரம்.",
    "ref": "கொலோ. 1:13"
  },
  {
    "id": 4,
    "tamil": "அன்பின் தேவனே ஸ்தோத்திரம்.",
    "ref": "1 யோவா. 4:8"
  },
  {
    "id": 5,
    "tamil": "அநாதி தேவனே ஸ்தோத்திரம்.",
    "ref": "உபா. 33:27"
  },
  {
    "id": 6,
    "tamil": "அதரிசனமுள்ள தேவனே ஸ்தோத்திரம்.",
    "ref": "1 தீமோ. 1:17"
  },
  {
    "id": 7,
    "tamil": "அல்பா ஒமெகாவுமானவரே ஸ்தோத்திரம்.",
    "ref": "வெளி. 1:8"
  },
  {
    "id": 8,
    "tamil": "அதிசயம் எனும் நாமமுள்ளவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 9:6"
  },
  {
    "id": 9,
    "tamil": "அற்புதங்களை செய்பவரே ஸ்தோத்திரம்.",
    "ref": "யாத். 15:11"
  },
  {
    "id": 10,
    "tamil": "அசைவாடும் ஆவியானவரே ஸ்தோத்திரம்.",
    "ref": "ஆதி. 1:2"
  },
  {
    "id": 11,
    "tamil": "அவர் கன்மலையானவர் ஸ்தோத்திரம்.",
    "ref": "உபா. 32:4"
  },
  {
    "id": 12,
    "tamil": "அவர் மகா நீதிபரர் ஸ்தோத்திரம்.",
    "ref": "யோபு. 37:23"
  },
  {
    "id": 13,
    "tamil": "அவர் பெரியவர் ஸ்தோத்திரம்.",
    "ref": "லூக். 1:32"
  },
  {
    "id": 14,
    "tamil": "அவர் நீதியும் செம்மையுமானவர் ஸ்தோத்திரம்.",
    "ref": "உபா. 32:4"
  },
  {
    "id": 15,
    "tamil": "அவர் கிரியை உத்தமமானது ஸ்தோத்திரம்.",
    "ref": "உபா. 32:4"
  },
  {
    "id": 16,
    "tamil": "அவர் உன்னதத்தில் வாசமாயிருக்கிறார் ஸ்தோத்திரம்.",
    "ref": "ஏசா. 33:5"
  },
  {
    "id": 17,
    "tamil": "அவர் ஆலோசனையில் ஆச்சரியமானவர் ஸ்தோத்திரம்.",
    "ref": "ஏசா. 28:29"
  },
  {
    "id": 18,
    "tamil": "அவர் வல்லமை நியாயத்தில் பெருத்தவர் ஸ்தோத்திரம்.",
    "ref": "யோபு. 37:23"
  },
  {
    "id": 19,
    "tamil": "அவர் வாயினின்று அறிவும் புத்தியும் வரும் ஸ்தோத்திரம்.",
    "ref": "நீதி. 2:6"
  },
  {
    "id": 20,
    "tamil": "அவர் எல்லாவற்றிற்கும் முந்தினவர் ஸ்தோத்திரம்.",
    "ref": "கொலோ. 1:17"
  },
  {
    "id": 21,
    "tamil": "அவர் சொல்ல ஆகும் கட்டளையிட நிற்கும் ஸ்தோத்திரம்.",
    "ref": "சங். 33:9"
  },
  {
    "id": 22,
    "tamil": "அவர் நியாயகேடில்லாத சத்தியமுள்ள தேவன் ஸ்தோத்திரம்.",
    "ref": "உபா. 32:4"
  },
  {
    "id": 23,
    "tamil": "அவர் காலங்களையும், சமயங்களையும் மாற்றுகிறவர் ஸ்தோத்திரம்.",
    "ref": "தானி. 2:21"
  },
  {
    "id": 24,
    "tamil": "அவர் எப்பொழுதும் கடிந்து கொள்ளார் ஸ்தோத்திரம்.",
    "ref": "சங். 103:9"
  },
  {
    "id": 25,
    "tamil": "அவர் நட்சத்திரங்களை பெயரிட்டு அழைக்கிறார் ஸ்தோத்திரம்.",
    "ref": "சங். 147:4"
  },
  {
    "id": 26,
    "tamil": "அவர் தமது புயத்தினால் அரசாளுகிறார் ஸ்தோத்திரம்.",
    "ref": "ஏசா. 40:10"
  },
  {
    "id": 27,
    "tamil": "அவர் உன்னை ஆதரிப்பார் ஸ்தோத்திரம்.",
    "ref": "சங். 55:22"
  },
  {
    "id": 28,
    "tamil": "அவர் ஒருவரையும் புறக்கணியார் ஸ்தோத்திரம்.",
    "ref": "யோபு. 36:5"
  },
  {
    "id": 29,
    "tamil": "அவர் மகிமையாய் வெற்றி சிறந்தார் ஸ்தோத்திரம்.",
    "ref": "யாத். 15"
  },
  {
    "id": 30,
    "tamil": "அவர் நீதியிலும், நியாயத்திலும் பிரியப்படுகிறார் ஸ்தோத்திரம்.",
    "ref": "சங். 33:5"
  },
  {
    "id": 31,
    "tamil": "அவர் தமது வசனத்தை அனுப்பி குணமாக்குகிறார் ஸ்தோத்திரம்.",
    "ref": "சங். 107:20"
  },
  {
    "id": 32,
    "tamil": "அவர் அக்கிரமங்களை மன்னிக்கிறவர் ஸ்தோத்திரம்.",
    "ref": "சங். 103:3"
  },
  {
    "id": 33,
    "tamil": "அவர் நோய்களையெல்லாம் குணமாக்குகிறவர் ஸ்தோத்திரம்.",
    "ref": "சங். 103:3"
  },
  {
    "id": 34,
    "tamil": "அவர் கிருபையினாலும், இரக்கத்தாலும் முடிசூட்டுகிறார் ஸ்தோத்திரம்.",
    "ref": "சங். 103:4"
  },
  {
    "id": 35,
    "tamil": "அவர் மனவிருப்பத்தின்படி அருள் செய்வார் ஸ்தோத்திரம்.",
    "ref": "சங். 20:4"
  },
  {
    "id": 36,
    "tamil": "அவர் ஆலோசனைகளை நிறைவேற்றுவார் ஸ்தோத்திரம்.",
    "ref": "சங். 20:4"
  },
  {
    "id": 37,
    "tamil": "அவர் சோதிக்கப்படுபவர்க்கு உதவி செய்ய வல்லவர் ஸ்தோத்திரம்.",
    "ref": "எபி. 2:18"
  },
  {
    "id": 38,
    "tamil": "அவர் கன்மலையை தண்ணீர் தடாகமாக மாற்றுகிறார் ஸ்தோத்திரம்.",
    "ref": "சங். 114:8"
  },
  {
    "id": 39,
    "tamil": "அவர் கற்பாறையை நீரூற்றுகளாக மாற்றுகிறார் ஸ்தோத்திரம்.",
    "ref": "சங். 114:8"
  },
  {
    "id": 40,
    "tamil": "அவர் உன் வாசல்களின் தாழ்ப்பாள்களை பலப்படுத்துகிறார் ஸ்தோத்திரம்.",
    "ref": "சங். 147:13"
  },
  {
    "id": 41,
    "tamil": "அவர் உன்னிடத்திலுள்ள உன் பிள்ளைகளை ஆசீர்வதிக்கிறார் ஸ்தோத்திரம்.",
    "ref": "சங். 147:13"
  },
  {
    "id": 42,
    "tamil": "அவர் உன் எல்லைகளை சமாதான முள்ளவைகளாக்குகிறார் ஸ்தோத்திரம்.",
    "ref": "சங். 147:14"
  },
  {
    "id": 43,
    "tamil": "அவர் உச்சிதமான கோதுமையினால் திருப்தியாக்குகிறார் ஸ்தோத்திரம்.",
    "ref": "சங். 147:14"
  },
  {
    "id": 44,
    "tamil": "அவர் தமது பரிசுத்தவான்களை கைவிடுவதில்லை ஸ்தோத்திரம்.",
    "ref": "சங். 37:28"
  },
  {
    "id": 45,
    "tamil": "அவரே காரியத்தை வாய்க்கப்பண்ணுவார் ஸ்தோத்திரம்.",
    "ref": "சங். 37:5"
  },
  {
    "id": 46,
    "tamil": "அவராலே சகலமும் உண்டாயிருக்கிறது ஸ்தோத்திரம்.",
    "ref": "1 கொரி. 8:6"
  },
  {
    "id": 47,
    "tamil": "அவராலேயன்றி வேறொருவராலும் இரட்சிப்பு இல்லை ஸ்தோத்திரம்.",
    "ref": "அப். 4:12"
  },
  {
    "id": 48,
    "tamil": "அவரே சபையாகிய சரீரத்திற்கு தலையானவர் ஸ்தோத்திரம்.",
    "ref": "கொலோ. 1:18"
  },
  {
    "id": 49,
    "tamil": "அவரை முழு இருதயத்தோடு தேடுகிறவன் பாக்கியவான் ஸ்தோத்திரம்.",
    "ref": "சங். 119:2"
  },
  {
    "id": 50,
    "tamil": "அந்தகாரத்திலுள்ள பொக்கிஷங்களை தருகிறவர் ஸ்தோத்திரம்.",
    "ref": "ஏசா. 45:3"
  },
  {
    "id": 51,
    "tamil": "அவருக்கு பயந்தவர்களுக்கு குறைவில்லை ஸ்தோத்திரம்.",
    "ref": "சங். 34:9"
  },
  {
    "id": 52,
    "tamil": "அவருடைய ராஜ்யம் அழியாதது ஸ்தோத்திரம்.",
    "ref": "தானி. 6:26"
  },
  {
    "id": 53,
    "tamil": "அவருடைய மகத்துவம் முடிவு வரை நிற்கும் ஸ்தோத்திரம்.",
    "ref": "தானி. 6:26"
  },
  {
    "id": 54,
    "tamil": "அவருடைய அறிவு அளவில்லாதது ஸ்தோத்திரம்.",
    "ref": "சங். 147:5"
  },
  {
    "id": 55,
    "tamil": "அவருடைய இரக்கங்கள் மகாபெரியது ஸ்தோத்திரம்.",
    "ref": "2 சாமு. 24:14 / 1 நாளா. 21:13"
  },
  {
    "id": 56,
    "tamil": "அவருடைய மகிமை வானங்களுக்கு மேலானது ஸ்தோத்திரம்.",
    "ref": "சங். 113:4"
  },
  {
    "id": 57,
    "tamil": "அவருடைய உண்மை தலைமுறை தலைமுறைக்குமுள்ளது ஸ்தோத்திரம்.",
    "ref": "சங். 100:5"
  },
  {
    "id": 58,
    "tamil": "அவருடைய மகத்துவம் ஆராய்ந்து முடியாதது ஸ்தோத்திரம்.",
    "ref": "சங். 145:3"
  },
  {
    "id": 59,
    "tamil": "அவருடைய கோபமோ ஒரு நிமிடம் ஸ்தோத்திரம்.",
    "ref": "சங். 30:5"
  },
  {
    "id": 60,
    "tamil": "அவருடைய தயவோ நீடிய வாழ்வு ஸ்தோத்திரம்.",
    "ref": "சங். 30:5"
  },
  {
    "id": 61,
    "tamil": "அவருடைய சௌந்தர்யம் பெரியது ஸ்தோத்திரம்.",
    "ref": "சக. 9:17"
  },
  {
    "id": 62,
    "tamil": "அவருடைய காருண்யம் பெரியது ஸ்தோத்திரம்.",
    "ref": "சக. 9:17"
  },
  {
    "id": 63,
    "tamil": "அவருடைய இரக்கங்களுக்கு முடிவில்லை ஸ்தோத்திரம்.",
    "ref": "புலம்பல் 3:22"
  },
  {
    "id": 64,
    "tamil": "அவருடைய தழும்புகளால் குணமானீர்கள் ஸ்தோத்திரம்.",
    "ref": "1 பேது. 2:24"
  },
  {
    "id": 65,
    "tamil": "ஆவிகளின் பிதாவே ஸ்தோத்திரம்.",
    "ref": "எபி. 12:9"
  },
  {
    "id": 66,
    "tamil": "ஆதியும் அந்தமுமானவரே ஸ்தோத்திரம்.",
    "ref": "வெளி. 1:8"
  },
  {
    "id": 67,
    "tamil": "ஆத்தும நேசரே ஸ்தோத்திரம்.",
    "ref": "உன்னத. 3:1"
  },
  {
    "id": 68,
    "tamil": "ஆலோசனை கர்த்தரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 9:6"
  },
  {
    "id": 69,
    "tamil": "ஆறுதல் அளிக்கும் தேவனே ஸ்தோத்திரம்.",
    "ref": "ரோம. 15:5"
  },
  {
    "id": 70,
    "tamil": "ஆதியிலே வார்த்தையாய் இருந்தவரே ஸ்தோத்திரம்.",
    "ref": "யோவா. 1:1"
  },
  {
    "id": 71,
    "tamil": "ஆபிரகாமின் தேவனே ஸ்தோத்திரம்.",
    "ref": "யாத். 3:15"
  },
  {
    "id": 72,
    "tamil": "ஆண்டவராகிய கர்த்தாவே ஸ்தோத்திரம்.",
    "ref": "ஆபகூக் 3:19"
  },
  {
    "id": 73,
    "tamil": "ஆகாசத்தில் கீழ்க்காற்றை வரப்பண்ணினவரே ஸ்தோத்திரம்.",
    "ref": "சங். 78:26"
  },
  {
    "id": 74,
    "tamil": "ஆபத்து நாளில் ஆதரவாயிருந்தவரே ஸ்தோத்திரம்.",
    "ref": "சங். 18:18"
  },
  {
    "id": 75,
    "tamil": "ஆவியிலே உள்ளான மனுஷனில் பலப்பட செய்பவரே ஸ்தோத்திரம்.",
    "ref": "எபே. 3:16"
  },
  {
    "id": 76,
    "tamil": "ஆவிக்குரிய சகல ஆசீர்வாதத்தாலும் ஆசீர்வதிப்பவரே ஸ்தோத்திரம்.",
    "ref": "எபே. 1:3"
  },
  {
    "id": 77,
    "tamil": "ஆலயத்தின் சம்பூரணத்தினால் திருப்தியாக்குபவரே ஸ்தோத்திரம்.",
    "ref": "சங். 36:8"
  },
  {
    "id": 78,
    "tamil": "ஆபத்திலே தப்புவித்து கனப்படுத்துகிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 91:15"
  },
  {
    "id": 79,
    "tamil": "ஆராய்ந்து முடியாத பெரிய காரியங்களை செய்பவரே ஸ்தோத்திரம்.",
    "ref": "யோபு 9:10"
  },
  {
    "id": 80,
    "tamil": "ஆண்டவரே நீர் நல்லவரும் மன்னிக்கிறவருமானவர் ஸ்தோத்திரம்.",
    "ref": "சங். 86:5"
  },
  {
    "id": 81,
    "tamil": "ஆபத்திலே கூப்பிடும் போது விடுவிக்கிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 50:15"
  },
  {
    "id": 82,
    "tamil": "ஆண்டவரே நீர் மனஉருக்கமும், இரக்கமுமானவர் ஸ்தோத்திரம்.",
    "ref": "சங். 86:15"
  },
  {
    "id": 83,
    "tamil": "ஆண்டவராகிய கர்த்தர் என் பெலன் ஸ்தோத்திரம்.",
    "ref": "ஆபகூக் 3:19"
  },
  {
    "id": 84,
    "tamil": "ஆண்டவரிடத்தில் இரக்கங்களும் மன்னிப்புகளும் உண்டு ஸ்தோத்திரம்.",
    "ref": "தானி. 9:9"
  },
  {
    "id": 85,
    "tamil": "ஆயிரம் தலைமுறைக்கும் இரக்கத்தை காக்கிறவரே ஸ்தோத்திரம்.",
    "ref": "யாத். 34:7"
  },
  {
    "id": 86,
    "tamil": "ஆயிரம் தலைமுறைக்கும் கிருபையை காக்கிறவரே ஸ்தோத்திரம்.",
    "ref": "எரே. 32:18"
  },
  {
    "id": 87,
    "tamil": "ஆயிரம் தலைமுறைக்கும் உடன்படிக்கையை காக்கிறவரே ஸ்தோத்திரம்.",
    "ref": "உபா. 7:9"
  },
  {
    "id": 88,
    "tamil": "ஆயிரம் தலைமுறைக்கும் தயவையும் காக்கிறவரே ஸ்தோத்திரம்.",
    "ref": "உபா. 7:9"
  },
  {
    "id": 89,
    "tamil": "இயேசு என்ற நாமத்திற்கு ஸ்தோத்திரம்.",
    "ref": "மத். 1:21"
  },
  {
    "id": 90,
    "tamil": "இரட்சண்ய கொம்பே ஸ்தோத்திரம்.",
    "ref": "சங். 18:2"
  },
  {
    "id": 91,
    "tamil": "இரட்சிப்பின் அதிபதியே ஸ்தோத்திரம்.",
    "ref": "எபி. 2:10"
  },
  {
    "id": 92,
    "tamil": "இரட்சிப்பின் கன்மலையே ஸ்தோத்திரம்.",
    "ref": "உபா. 32:15"
  },
  {
    "id": 93,
    "tamil": "இரட்சிப்பின் தேவனே ஸ்தோத்திரம்.",
    "ref": "சங். 24:5"
  },
  {
    "id": 94,
    "tamil": "இம்மானுவேலே ஸ்தோத்திரம்.",
    "ref": "மத். 1:23"
  },
  {
    "id": 95,
    "tamil": "இயேசு கிறிஸ்துவின் பிதாவே ஸ்தோத்திரம்.",
    "ref": "2 கொரி. 11:31"
  },
  {
    "id": 96,
    "tamil": "இயேசு கிறிஸ்து எனும் ஒரே கர்த்தரே ஸ்தோத்திரம்.",
    "ref": "1 கொரி. 8:6"
  },
  {
    "id": 97,
    "tamil": "இயேசு கிறிஸ்து நேற்றும் இன்றும் என்றும் மாறாதவர் ஸ்தோத்திரம்.",
    "ref": "எபி. 13:8"
  },
  {
    "id": 98,
    "tamil": "இருக்கிறவரும், இருந்தவரும், வருகிறவருமானவரே ஸ்தோத்திரம்.",
    "ref": "வெளி. 11:17"
  },
  {
    "id": 99,
    "tamil": "இருக்கிறவராகவே இருக்கிறேன் என்றவரே ஸ்தோத்திரம்.",
    "ref": "யாத். 3:14"
  },
  {
    "id": 100,
    "tamil": "இருபுறமும் கருக்குள்ள பட்டயத்தை உடையவரே ஸ்தோத்திரம்.",
    "ref": "வெளி. 2:12"
  },
  {
    "id": 101,
    "tamil": "இருப்புத் தாழ்ப்பாள்களை முறிக்கிறவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 45:2"
  },
  {
    "id": 102,
    "tamil": "இருதயங்களை சோதித்தறிகிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 17:3"
  },
  {
    "id": 103,
    "tamil": "இரட்டிப்பான நன்மைகளை தருபவரே ஸ்தோத்திரம்.",
    "ref": "சக. 9:12"
  },
  {
    "id": 104,
    "tamil": "இக்கட்டு நாளில் அரணான கோட்டையே ஸ்தோத்திரம்.",
    "ref": "நாகூம் 1:7"
  },
  {
    "id": 105,
    "tamil": "இஸ்ரவேலின் தேவனே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 37:16"
  },
  {
    "id": 106,
    "tamil": "இஸ்ரவேலின் பரிசுத்தரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 43:3"
  },
  {
    "id": 107,
    "tamil": "இஸ்ரவேலின் மேய்ப்பரே ஸ்தோத்திரம்.",
    "ref": "சங். 80:1"
  },
  {
    "id": 108,
    "tamil": "இஸ்ரவேலை ஆளும் பிரபுவே ஸ்தோத்திரம்.",
    "ref": "மீகா 5:2 / மத். 2:6"
  },
  {
    "id": 109,
    "tamil": "இஸ்ரவேலின் ராஜாவே ஸ்தோத்திரம்.",
    "ref": "யோவா. 1:49"
  },
  {
    "id": 110,
    "tamil": "இஸ்ரவேலின் ஜெயபலமானவரே ஸ்தோத்திரம்.",
    "ref": "1 சாமு. 15:29"
  },
  {
    "id": 111,
    "tamil": "இஸ்ரவேலுக்கு பனியாயிருப்பவரே ஸ்தோத்திரம்.",
    "ref": "ஓசியா 14:5"
  },
  {
    "id": 112,
    "tamil": "இஸ்ரவேலை ஆசீர்வதிப்பதே பிரியம் என்றவரே ஸ்தோத்திரம்.",
    "ref": "எண்ணா. 24:1"
  },
  {
    "id": 113,
    "tamil": "இதோ நான் சகலத்தையும் புதிதாக்குகிறேன் என்றவரே ஸ்தோத்திரம்.",
    "ref": "வெளி. 21:5"
  },
  {
    "id": 114,
    "tamil": "இதோ இஸ்ரவேலை காக்கிறவர் உறங்குவதுமில்லை, தூங்குகிறதுமில்லை ஸ்தோத்திரம்.",
    "ref": "சங். 121:4"
  },
  {
    "id": 115,
    "tamil": "இதோ உலகத்தின் பாவத்தை சுமந்து தீர்த்த தேவ ஆட்டுக்குட்டி ஸ்தோத்திரம்.",
    "ref": "யோவா. 1:29"
  },
  {
    "id": 116,
    "tamil": "இதோ நான் ஒரு தூதனை உமக்கு முன்பாக அனுப்புகிறேன் ஸ்தோத்திரம்.",
    "ref": "யாத். 23:20"
  },
  {
    "id": 117,
    "tamil": "இதோ நான் உங்கள் பட்சத்திலிருந்து உங்களை கண்ணோக்குவேன் ஸ்தோத்திரம்.",
    "ref": "எசேக். 36:9"
  },
  {
    "id": 118,
    "tamil": "இதோ உலகின் முடிவுவரை சகல நாளும் உன்னோடிருக்கிறேன் ஸ்தோத்திரம்.",
    "ref": "மத். 28:20"
  },
  {
    "id": 119,
    "tamil": "இதோ என் உள்ளங்கைகளில் உன்னை வரைந்திருக்கிறேன் ஸ்தோத்திரம்.",
    "ref": "ஏசா. 49:16"
  },
  {
    "id": 120,
    "tamil": "இதோ தேவன் தண்டிக்கிற மனுஷன் பாக்கியவான் ஸ்தோத்திரம்.",
    "ref": "யோபு 5:17"
  },
  {
    "id": 121,
    "tamil": "இதோ இரட்சிக்க கூடாதபடி கர்த்தர் குறுகிபோகவில்லை ஸ்தோத்திரம்.",
    "ref": "ஏசா. 59:1"
  },
  {
    "id": 122,
    "tamil": "இதோ கர்த்தருக்கு பயப்படுகிற மனுஷன் ஆசீர்வதிக்கப்படுவான் ஸ்தோத்திரம்.",
    "ref": "சங். 128:4"
  },
  {
    "id": 123,
    "tamil": "இதோ நான் உனக்காக வழக்காடுவேன் ஸ்தோத்திரம்.",
    "ref": "எரே. 51:36"
  },
  {
    "id": 124,
    "tamil": "இதோ பிள்ளைகள் கர்த்தரால் வரும் சுதந்தரம் ஸ்தோத்திரம்.",
    "ref": "சங். 127:3"
  },
  {
    "id": 125,
    "tamil": "இதோ ஆண்டவருக்கு பயப்படுவதே ஞானம் ஸ்தோத்திரம்.",
    "ref": "யோபு 28:28"
  },
  {
    "id": 126,
    "tamil": "இதோ சீக்கிரமாய் வருகிறேன் என்றவரே ஸ்தோத்திரம்.",
    "ref": "வெளி. 22:7"
  },
  {
    "id": 127,
    "tamil": "ஈசாயென்னும் அடிமரமே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 11:1"
  },
  {
    "id": 128,
    "tamil": "ஈசாக்கின் தேவனே ஸ்தோத்திரம்.",
    "ref": "யாத். 3:15"
  },
  {
    "id": 129,
    "tamil": "ஈசோப்பினால் சுத்திகரிப்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 51:7"
  },
  {
    "id": 130,
    "tamil": "ஈசாக்கின் பயபக்திக்குரியவரே ஸ்தோத்திரம்.",
    "ref": "ஆதி. 31:42"
  },
  {
    "id": 131,
    "tamil": "ஈவின் அளவுக்குதக்கதாக கிருபை அளிப்பவரே ஸ்தோத்திரம்.",
    "ref": "எபே. 4:7"
  },
  {
    "id": 132,
    "tamil": "உண்மையுள்ள தேவனே ஸ்தோத்திரம்.",
    "ref": "1 கொரி. 1:9"
  },
  {
    "id": 133,
    "tamil": "உயிர்த்தெழுந்தவரே ஸ்தோத்திரம்.",
    "ref": "லூக். 24:6"
  },
  {
    "id": 134,
    "tamil": "உலகிற்கு ஒளியானவரே ஸ்தோத்திரம்.",
    "ref": "யோவா. 9:5"
  },
  {
    "id": 135,
    "tamil": "உலக இரட்சகரே ஸ்தோத்திரம்.",
    "ref": "1 யோவா. 4:14"
  },
  {
    "id": 136,
    "tamil": "உயிர்ப்பிக்கிற ஆவியானவரே ஸ்தோத்திரம்.",
    "ref": "2 கொரி. 3:6 / ரோம. 8:11"
  },
  {
    "id": 137,
    "tamil": "உன்னதங்களில் வாசம் பண்ணுகிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 112:5"
  },
  {
    "id": 138,
    "tamil": "உளையான சேற்றிலிருந்து தூக்கினவரே ஸ்தோத்திரம்.",
    "ref": "சங். 40:2"
  },
  {
    "id": 139,
    "tamil": "உண்மையாய் கூப்பிடுபவர்க்கு சமீபமானவரே ஸ்தோத்திரம்.",
    "ref": "சங். 145:18"
  },
  {
    "id": 140,
    "tamil": "உச்சிதமான கோதுமையினால் திருப்தியாக்குபவரே ஸ்தோத்திரம்.",
    "ref": "சங். 147:14"
  },
  {
    "id": 141,
    "tamil": "உபத்திரவத்திலே பொறுமையாயிருங்கள் என்றவரே ஸ்தோத்திரம்.",
    "ref": "ரோம. 12:12"
  },
  {
    "id": 142,
    "tamil": "உனக்கு பாக்கியமும், நன்மையும் உண்டாயிருக்கும் ஸ்தோத்திரம்.",
    "ref": "சங். 128:2"
  },
  {
    "id": 143,
    "tamil": "உனக்கு விரோதமாய் உருவாக்கின ஆயுதம் வாய்க்காதேபோம் என்றவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 54:17"
  },
  {
    "id": 144,
    "tamil": "உன்னை நான் மீட்டு கொண்டேன் என்றவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 44:22"
  },
  {
    "id": 145,
    "tamil": "உன்னை நிச்சயமாக விடுவிப்பேன் என்றவரே ஸ்தோத்திரம்.",
    "ref": "எரே. 39:18"
  },
  {
    "id": 146,
    "tamil": "உன்னை ஆசீர்வதிக்கிறவர்களை ஆசீர்வதிப்பேன் என்றவரே ஸ்தோத்திரம்.",
    "ref": "ஆதி. 12:3"
  },
  {
    "id": 147,
    "tamil": "உமது நாமம் பலத்த துருகம் ஸ்தோத்திரம்.",
    "ref": "நீதி. 18:10"
  },
  {
    "id": 148,
    "tamil": "உமது காருண்யம் பெரியது ஸ்தோத்திரம்.",
    "ref": "2 சாமு. 22:36"
  },
  {
    "id": 149,
    "tamil": "உமது கிருபை பெரியது ஸ்தோத்திரம்.",
    "ref": "சங். 86:13"
  },
  {
    "id": 150,
    "tamil": "உமது உண்மை பெரியது ஸ்தோத்திரம்.",
    "ref": "புலம்பல் 3:23"
  },
  {
    "id": 151,
    "tamil": "உமது சிங்காசனம் பூர்வமுதல் உறுதியானது ஸ்தோத்திரம்.",
    "ref": "சங். 93:2"
  },
  {
    "id": 152,
    "tamil": "உமது ஆண்டுகள் முடிந்து போவதில்லை ஸ்தோத்திரம்.",
    "ref": "சங். 102:27"
  },
  {
    "id": 153,
    "tamil": "உமது சாட்சிகள் மிகவும் உண்மையானவை ஸ்தோத்திரம்.",
    "ref": "சங். 93:5"
  },
  {
    "id": 154,
    "tamil": "உமது கிருபை என்னை தாங்குகிறது ஸ்தோத்திரம்.",
    "ref": "சங். 94:18"
  },
  {
    "id": 155,
    "tamil": "உமது பாதைகள் நெய்யாய் பொழிகிறது ஸ்தோத்திரம்.",
    "ref": "சங். 65:11"
  },
  {
    "id": 156,
    "tamil": "உமது சமூகத்தை விட்டு என்னை தள்ளாதவரே ஸ்தோத்திரம்.",
    "ref": "சங். 51:11"
  },
  {
    "id": 157,
    "tamil": "உமது கோலும், உமது தடியும் என்னை தேற்றும் ஸ்தோத்திரம்.",
    "ref": "சங். 23:4"
  },
  {
    "id": 158,
    "tamil": "உன் கைகளின் பிரயாசத்தை நீ சாப்பிடுவாய் என்றவரே ஸ்தோத்திரம்.",
    "ref": "சங். 128:2"
  },
  {
    "id": 159,
    "tamil": "உன் போக்கையும், வரத்தையும் என்றும் காப்பார் ஸ்தோத்திரம்.",
    "ref": "சங். 121:8"
  },
  {
    "id": 160,
    "tamil": "உன் அப்பத்தையும், தண்ணீரையும் ஆசீர்வதிப்பார் ஸ்தோத்திரம்.",
    "ref": "யாத். 23:25"
  },
  {
    "id": 161,
    "tamil": "உன் துக்க நாட்கள் முடிந்துபோம் என்றவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 60:20"
  },
  {
    "id": 162,
    "tamil": "உன் கிரியைகளுக்கு பலன் உண்டு என்றவரே ஸ்தோத்திரம்.",
    "ref": "எரே. 31:16"
  },
  {
    "id": 163,
    "tamil": "உன் பிள்ளைகளின் சமாதானம் பெரிதாயிருக்கும் என்றவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 54:13"
  },
  {
    "id": 164,
    "tamil": "உன் பிள்ளைகள் கர்த்தரால் போதிக்கப்பட்டிருப்பார்கள் ஸ்தோத்திரம்.",
    "ref": "ஏசா. 54:13"
  },
  {
    "id": 165,
    "tamil": "உன் சந்ததியின்மேல் என் ஆவியை ஊற்றுவேன் என்றவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 44:3"
  },
  {
    "id": 166,
    "tamil": "உன் சந்தானத்தின் மேல் என் ஆசீர்வாதத்தை ஊற்றுவேன் ஸ்தோத்திரம்.",
    "ref": "ஏசா. 44:3"
  },
  {
    "id": 167,
    "tamil": "உன் காலை தள்ளாடவொட்டார் ஸ்தோத்திரம்.",
    "ref": "சங். 121:3"
  },
  {
    "id": 168,
    "tamil": "உம்முடைய நீதி நியாயமெல்லாம் நித்தியம் ஸ்தோத்திரம்.",
    "ref": "சங். 119:160"
  },
  {
    "id": 169,
    "tamil": "உம்முடைய வலது கரம் என்னை தாங்குகிறது ஸ்தோத்திரம்.",
    "ref": "சங். 18:35"
  },
  {
    "id": 170,
    "tamil": "உம்முடைய காருண்யம் என்னை பெரியவனாக்கும் ஸ்தோத்திரம்.",
    "ref": "சங். 18:35"
  },
  {
    "id": 171,
    "tamil": "உம்முடைய ஆறுதல்கள் என்னை தேற்றுகிறது ஸ்தோத்திரம்.",
    "ref": "சங். 94:19"
  },
  {
    "id": 172,
    "tamil": "உம்முடைய சமூகத்தில் பரிபூரண ஆனந்தமுண்டு ஸ்தோத்திரம்.",
    "ref": "சங். 16:11"
  },
  {
    "id": 173,
    "tamil": "உம்முடைய கூடாரம் சமாதானத்துடனிருக்கும் ஸ்தோத்திரம்.",
    "ref": "யோபு 5:24"
  },
  {
    "id": 174,
    "tamil": "உம்முடைய இரட்சிப்பின் கேடகத்தை தந்தீரே ஸ்தோத்திரம்.",
    "ref": "சங். 18:35"
  },
  {
    "id": 175,
    "tamil": "உம்முடைய தயவினால் என் கொம்பு உயரும் ஸ்தோத்திரம்.",
    "ref": "சங். 89:17"
  },
  {
    "id": 176,
    "tamil": "உம்முடைய இரக்கம் காருண்யங்களை நினைத்தருளும் ஸ்தோத்திரம்.",
    "ref": "சங். 25:6"
  },
  {
    "id": 177,
    "tamil": "உம்முடைய வேதம் என் மனமகிழ்ச்சி ஸ்தோத்திரம்.",
    "ref": "சங். 119:174"
  },
  {
    "id": 178,
    "tamil": "உம்முடைய வேதத்தை நேசிப்பவர்க்கு மிகுந்த சமாதானமுண்டு ஸ்தோத்திரம்.",
    "ref": "சங். 119:165"
  },
  {
    "id": 179,
    "tamil": "உம்முடைய வசனம் என் கால்களுக்கு தீபம் ஸ்தோத்திரம்.",
    "ref": "சங். 119:105"
  },
  {
    "id": 180,
    "tamil": "உம்முடைய வசனம் என் பாதைக்கு வெளிச்சம் ஸ்தோத்திரம்.",
    "ref": "சங். 119:105"
  },
  {
    "id": 181,
    "tamil": "உம்முடைய வாக்கு என்னை உயிர்ப்பித்தது ஸ்தோத்திரம்.",
    "ref": "சங். 119:50"
  },
  {
    "id": 182,
    "tamil": "ஊற்றுத்தண்ணீரே ஸ்தோத்திரம்.",
    "ref": "எண்ணா. 21:17"
  },
  {
    "id": 183,
    "tamil": "ஊற்றையும், ஆற்றையும் பிளந்தவரே ஸ்தோத்திரம்.",
    "ref": "சங். 74:15"
  },
  {
    "id": 184,
    "tamil": "ஊற்றுண்ட பரிமளத் தைலமே ஸ்தோத்திரம்.",
    "ref": "உன்னத. 1:3"
  },
  {
    "id": 185,
    "tamil": "ஊற்றுகள் உண்டாகுமுன்னே ஜநிபிக்கப்பட்டவரே ஸ்தோத்திரம்.",
    "ref": "நீதி. 8:24"
  },
  {
    "id": 186,
    "tamil": "ஊழியக்காரரை அக்கினி ஜூவாலைகளாக்குகிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 104:4"
  },
  {
    "id": 187,
    "tamil": "ஊழியக்காரர்மேல் பரிதாபப்படுகிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 135:14"
  },
  {
    "id": 188,
    "tamil": "ஊழியக்காரரின் சுகத்தை விரும்புகிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 35:27"
  },
  {
    "id": 189,
    "tamil": "ஊழியக்காரரின் வார்த்தையை நிலைப்படுத்துகிறவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 44:26"
  },
  {
    "id": 190,
    "tamil": "ஊழியக்காரரை மனமகிழ்ச்சியினால் கெம்பீரிக்க செய்பவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 65:14"
  },
  {
    "id": 191,
    "tamil": "ஊழியக்காரருக்கு தமது இரகசியத்தை வெளிப்படுத்துகிறவரே ஸ்தோத்திரம்.",
    "ref": "ஆமோஸ் 3:7"
  },
  {
    "id": 192,
    "tamil": "எல்ஷடாய் தேவனே ஸ்தோத்திரம்.",
    "ref": "ஆதி. 17:1"
  },
  {
    "id": 193,
    "tamil": "எலியாவின் தேவனே ஸ்தோத்திரம்.",
    "ref": "2 இராஜா. 2:14"
  },
  {
    "id": 194,
    "tamil": "எரிச்சலின் தேவனே ஸ்தோத்திரம்.",
    "ref": "யாத். 20:5"
  },
  {
    "id": 195,
    "tamil": "எல்லா தேவர்களுக்கும் மேலானவரே ஸ்தோத்திரம்.",
    "ref": "சங். 135:5"
  },
  {
    "id": 196,
    "tamil": "எம் எல்லாருக்கும் ஒரே பிதாவே ஸ்தோத்திரம்.",
    "ref": "மல்கியா 2:10"
  },
  {
    "id": 197,
    "tamil": "எல்லாவற்றையும் எல்லாவற்றாலும் நிரப்புகிறவரே ஸ்தோத்திரம்.",
    "ref": "எபே. 1:23"
  },
  {
    "id": 198,
    "tamil": "என்னை உண்டாக்கின பிதாவே ஸ்தோத்திரம்.",
    "ref": "உபா. 32:6"
  },
  {
    "id": 199,
    "tamil": "என்னை ஆட்கொண்ட பிதாவே ஸ்தோத்திரம்.",
    "ref": "உபா. 32:6"
  },
  {
    "id": 200,
    "tamil": "என்னை காண்கின்ற தேவனே ஸ்தோத்திரம்.",
    "ref": "ஆதி. 16:13"
  },
  {
    "id": 201,
    "tamil": "என்னை நிலைப்படுத்தின பிதாவே ஸ்தோத்திரம்.",
    "ref": "உபா. 32:6"
  },
  {
    "id": 202,
    "tamil": "என்னை விசாரிக்கிவரே ஸ்தோத்திரம்.",
    "ref": "1 பேது. 5:7"
  },
  {
    "id": 203,
    "tamil": "என்னை பலப்படுத்துகிறவரே ஸ்தோத்திரம்.",
    "ref": "பிலிப். 4:13"
  },
  {
    "id": 204,
    "tamil": "என்னை சுகமாய் தங்கப் பண்ணுகிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 4:8"
  },
  {
    "id": 205,
    "tamil": "என்னை நெருக்கத்திலிருந்து விசாலத்தில் கொண்டு வந்தவரே ஸ்தோத்திரம்.",
    "ref": "சங். 18:19"
  },
  {
    "id": 206,
    "tamil": "என் தலையை உயர்த்துகிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 3:3"
  },
  {
    "id": 207,
    "tamil": "என் காலங்கள் உமது கரத்திலுள்ளது ஸ்தோத்திரம்.",
    "ref": "சங். 31:15"
  },
  {
    "id": 208,
    "tamil": "என் கண்களை கண்ணீருக்கு தப்புவித்தவரே ஸ்தோத்திரம்.",
    "ref": "சங். 116:8"
  },
  {
    "id": 209,
    "tamil": "என் இருளை வெளிச்சமாக்குகிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 18:28"
  },
  {
    "id": 210,
    "tamil": "என் புலம்பலை ஆனந்தகளிப்பாக மாறப்பண்ணுபவரே ஸ்தோத்திரம்.",
    "ref": "சங். 30:11"
  },
  {
    "id": 211,
    "tamil": "என் கருவை உம் கண்கள் கண்டதற்காக ஸ்தோத்திரம்.",
    "ref": "சங். 139:16"
  },
  {
    "id": 212,
    "tamil": "என் கிருபை உனக்கு போதும் என்றவரே ஸ்தோத்திரம்.",
    "ref": "2 கொரி. 12:9"
  },
  {
    "id": 213,
    "tamil": "என் ஜெபத்தை தள்ளாமலிருந்தவரே ஸ்தோத்திரம்.",
    "ref": "சங். 66:20"
  },
  {
    "id": 214,
    "tamil": "என் வார்த்தைகளோ ஒழிந்து போவதில்லை ஸ்தோத்திரம்.",
    "ref": "மத். 24:35"
  },
  {
    "id": 215,
    "tamil": "என் நாமத்தினாலே எதை கேட்டாலும் அதை நான் செய்வேன் என்றவரே ஸ்தோத்திரம்.",
    "ref": "யோவா. 14:14"
  },
  {
    "id": 216,
    "tamil": "என் வசனத்திற்கு நடுங்குபவனையே நோக்கி பார்ப்பேன் என்றவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 66:2"
  },
  {
    "id": 217,
    "tamil": "என் சமூகம் உனக்கு முன்பாக செல்லும் என்றவரே ஸ்தோத்திரம்.",
    "ref": "யாத். 33:14"
  },
  {
    "id": 218,
    "tamil": "என் தேவனாலே ஒரு மதிலைத் தாண்டுவேன் ஸ்தோத்திரம்.",
    "ref": "சங். 18:29"
  },
  {
    "id": 219,
    "tamil": "என் அலைச்சல்களை எண்ணியிருக்கிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 56:8"
  },
  {
    "id": 220,
    "tamil": "என் கண்ணீரை கணக்கில் வைத்திருப்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 56:8"
  },
  {
    "id": 221,
    "tamil": "எளியவனை மறக்காதவரே ஸ்தோத்திரம்.",
    "ref": "சங். 9:18"
  },
  {
    "id": 222,
    "tamil": "எளியவனை குப்பையிலிருந்து உயர்த்துகிறவரே ஸ்தோத்திரம்.",
    "ref": "சங். 113:7"
  },
  {
    "id": 223,
    "tamil": "எளியவனின் விண்ணப்பத்தை கேட்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 69:33"
  },
  {
    "id": 224,
    "tamil": "எளியவனின் நியாயத்தை விசாரிப்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 140:12"
  },
  {
    "id": 225,
    "tamil": "எளியவனை உயர்ந்த அடைக்கலத்தில் வைப்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 107:41"
  },
  {
    "id": 226,
    "tamil": "எளியவனை பிரபுக்கள் அதிபதிகளோடு உட்கார வைப்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 113:8"
  },
  {
    "id": 227,
    "tamil": "எந்த மனுஷனையும் பிரகாசிப்பிக்கிற ஒளியே ஸ்தோத்திரம்.",
    "ref": "யோவா. 1:9"
  },
  {
    "id": 228,
    "tamil": "எரிகோவின் கோட்டையை வீழ்த்தியவரே ஸ்தோத்திரம்.",
    "ref": "யோசு. 6:20"
  },
  {
    "id": 229,
    "tamil": "எண்ணி முடியா அதிசயம் செய்பவரே ஸ்தோத்திரம்.",
    "ref": "யோபு 9:10"
  },
  {
    "id": 230,
    "tamil": "எனக்கு குறித்திருக்கிறதை நிறைவேற்றுபவரே ஸ்தோத்திரம்.",
    "ref": "யோபு 23:14"
  },
  {
    "id": 231,
    "tamil": "எனக்காக யாவையும் செய்து முடிப்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 57:2"
  },
  {
    "id": 232,
    "tamil": "எலும்பு முறிந்ததை காயம் கட்டுபவரே ஸ்தோத்திரம்.",
    "ref": "எசேக். 34:16"
  },
  {
    "id": 233,
    "tamil": "எல்லாவற்றிலும் சம்பூரணமடைய செய்பவரே ஸ்தோத்திரம்.",
    "ref": "2 கொரி. 9:8"
  },
  {
    "id": 234,
    "tamil": "என்னிடம் வருபவனை நான் புறம்பே தள்ளுவதில்லை ஸ்தோத்திரம்.",
    "ref": "யோவா. 6:37"
  },
  {
    "id": 235,
    "tamil": "எவர்களை முன்குறித்தீரோ அவர்களை அழைத்தவரே ஸ்தோத்திரம்.",
    "ref": "ரோம. 8:30"
  },
  {
    "id": 236,
    "tamil": "ஏக சக்ராதிபதியே ஸ்தோத்திரம்.",
    "ref": "1 தீமோ. 6:15"
  },
  {
    "id": 237,
    "tamil": "ஏழைக்கு பெலனானவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 25:4"
  },
  {
    "id": 238,
    "tamil": "ஏழையின் கூப்பிடுதலை கேட்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 34:6"
  },
  {
    "id": 239,
    "tamil": "ஏழைக்கு நியாயம் செய்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 82:3"
  },
  {
    "id": 240,
    "tamil": "ஏற்ற காலத்தில் ஆசீர்வாத மழையை பெய்ய பண்ணுகிறவரே ஸ்தோத்திரம்.",
    "ref": "எசேக். 34:26"
  },
  {
    "id": 241,
    "tamil": "ஏழு பொன் குத்துவிளக்கின் மத்தியில் உலாவுகிறவரே ஸ்தோத்திரம்.",
    "ref": "வெளி. 2:1"
  },
  {
    "id": 242,
    "tamil": "ஏழு நட்சத்திரத்தை வலக்கரத்தில் ஏந்தியிருக்கிறவரே ஸ்தோத்திரம்.",
    "ref": "வெளி. 2:1"
  },
  {
    "id": 243,
    "tamil": "ஏற்ற காலத்தில் சொன்ன வார்த்தை எவ்வளவு நல்லது ஸ்தோத்திரம்.",
    "ref": "நீதி. 15:23"
  },
  {
    "id": 244,
    "tamil": "ஏற்ற காலத்தில் உயர்த்தும்படி அவர் கரத்தில் அடங்கியிருங்கள் ஸ்தோத்திரம்.",
    "ref": "1 பேது. 5:6"
  },
  {
    "id": 245,
    "tamil": "ஏக சிந்தை ஏக அன்புள்ளவர்களாயிருங்கள் ஸ்தோத்திரம்.",
    "ref": "பிலிப் 2:2"
  },
  {
    "id": 246,
    "tamil": "ஐசுவரிய சம்மன்னரே ஸ்தோத்திரம்.",
    "ref": "ரோம. 10:12"
  },
  {
    "id": 247,
    "tamil": "ஐசுவரியத்தின் தேவனே ஸ்தோத்திரம்.",
    "ref": "பிலிப். 4:19"
  },
  {
    "id": 248,
    "tamil": "ஐசுவரியமும் கனமும் உம்மாலே வரும் ஸ்தோத்திரம்.",
    "ref": "1 நாளா. 29:12"
  },
  {
    "id": 249,
    "tamil": "ஐசுவரியமும், கனமும் உம்மிடத்தில் உண்டு ஸ்தோத்திரம்.",
    "ref": "நீதி. 8:18"
  },
  {
    "id": 250,
    "tamil": "ஐசுவரியத்தை சம்பாதிக்க பெலன் கொடுக்கிறவன் ஸ்தோத்திரம்.",
    "ref": "உபா. 8:18"
  },
  {
    "id": 251,
    "tamil": "ஐந்து அப்பம் 2 மீன் 5000 பேருகு பங்கிட செய்தவரே ஸ்தோத்திரம்.",
    "ref": "மத். 14:19"
  },
  {
    "id": 252,
    "tamil": "ஐசுவரியவானாகிறதற்கு தீவிரிக்கிறவரே ஆக்கினைக்கு தப்பான் ஸ்தோத்திரம்.",
    "ref": "நீதி. 28:20"
  },
  {
    "id": 253,
    "tamil": "ஒப்பற்றவரே ஸ்தோத்திரம்.",
    "ref": "யாத். 15:11"
  },
  {
    "id": 254,
    "tamil": "ஒன்றான மெய்த் தேவனே ஸ்தோத்திரம்.",
    "ref": "யோவா. 17:3"
  },
  {
    "id": 255,
    "tamil": "ஒருவரே ஞானமுள்ளவர் ஸ்தோத்திரம்.",
    "ref": "யூதா 25"
  },
  {
    "id": 256,
    "tamil": "ஒரே மேய்ப்பவனே ஸ்தோத்திரம்.",
    "ref": "எசேக். 37:24"
  },
  {
    "id": 257,
    "tamil": "ஒருவரையும் கடிந்து கொள்ளாதவரே ஸ்தோத்திரம்.",
    "ref": "யாக். 1:5"
  },
  {
    "id": 258,
    "tamil": "ஒருவராய் சாவாமையுள்ளவரே ஸ்தோத்திரம்.",
    "ref": "1 தீமோ. 6:16"
  },
  {
    "id": 259,
    "tamil": "ஒளியை வஸ்திரமாக தரித்திருப்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 104:2"
  },
  {
    "id": 260,
    "tamil": "ஒத்தாசை வரும் பர்வதமே ஸ்தோத்திரம்.",
    "ref": "சங். 121:1"
  },
  {
    "id": 261,
    "tamil": "ஒருவராய் பெரிய அதிசயங்களை செய்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 136:4"
  },
  {
    "id": 262,
    "tamil": "ஒரு தாய் தேற்றுவது போல தேற்றுபவரே ஸ்தோத்திரம்.",
    "ref": "ஏசா. 66:13"
  },
  {
    "id": 263,
    "tamil": "ஒருவரும் பூட்டக்கூடாதபடிக்கு திறக்கிறவரே ஸ்தோத்திரம்.",
    "ref": "வெளி. 3:7"
  },
  {
    "id": 264,
    "tamil": "ஒருவரும் திறக்க கூடாதபடிக்கு பூட்டுகிறவரே ஸ்தோத்திரம்.",
    "ref": "வெளி. 3:7"
  },
  {
    "id": 265,
    "tamil": "ஒடுக்கப்படுகிறவர்க்கு நீதி நியாயம் செய்பவரே ஸ்தோத்திரம்.",
    "ref": "சங். 103:6"
  },
  {
    "id": 266,
    "tamil": "ஒருவனுக்கும் தீமைக்கு தீமை செய்யாதிருங்கள் ஸ்தோத்திரம்.",
    "ref": "ரோம. 12:17"
  },
  {
    "id": 267,
    "tamil": "ஒருவரில் ஒருவர் அன்பாயிருங்கள் ஸ்தோத்திரம்.",
    "ref": "யோவா. 13:34"
  },
  {
    "id": 268,
    "tamil": "ஒருவர் மேல் ஒருவர் பட்சமாயிருங்கள் ஸ்தோத்திரம்.",
    "ref": "ரோம. 12:10"
  },
  {
    "id": 269,
    "tamil": "ஒருவர் பாரத்தை ஒருவர் சுமந்து கொள்ளுங்கள் ஸ்தோத்திரம்.",
    "ref": "கலாத். 6:2"
  },
  {
    "id": 270,
    "tamil": "ஒருவருடைய கால்களை ஒருவர் கழுவுங்கள் ஸ்தோத்திரம்.",
    "ref": "யோவா. 13:14"
  },
  {
    "id": 271,
    "tamil": "ஒருவரை ஒருவர் தேற்றுங்கள் ஸ்தோத்திரம்.",
    "ref": "1 தெச. 4:18"
  },
  {
    "id": 272,
    "tamil": "ஒருவரையொருவர் கோபமூட்டாதிருங்கள் ஸ்தோத்திரம்.",
    "ref": "கலாத். 5:26"
  },
  {
    "id": 273,
    "tamil": "ஒருவரையொருவர் குற்றவாளிகளாக தீர்க்காதிருங்கள் ஸ்தோத்திரம்.",
    "ref": "ரோம. 14:13"
  },
  {
    "id": 274,
    "tamil": "ஒருவரையொருவர் கடிந்து பட்சிக்காதிருங்கள் ஸ்தோத்திரம்.",
    "ref": "கலாத். 5:15"
  },
  {
    "id": 275,
    "tamil": "ஒருவரையொருவர் முறுமுறுப்பில்லாமல் உபசரியுங்கள் ஸ்தோத்திரம்.",
    "ref": "1 பேது. 4:9"
  },
  {
    "id": 276,
    "tamil": "ஒருவரையொருவர் தாங்கிக் கொள்ளுங்கள் ஸ்தோத்திரம்.",
    "ref": "கொலோ. 3:13"
  },
  {
    "id": 277,
    "tamil": "ஒருவரையொருவர் அன்பினால் வாழ்த்துங்கள் ஸ்தோத்திரம்.",
    "ref": "1 பேது. 5:14"
  },
  {
    "id": 278,
    "tamil": "ஒருவருக்கொருவர் அவயவங்களாயிருங்கள் ஸ்தோத்திரம்.",
    "ref": "ரோம. 12:5"
  },
  {
    "id": 279,
    "tamil": "ஒருவருக்கொருவர் புத்தி சொல்லுங்கள் ஸ்தோத்திரம்.",
    "ref": "எபி. 10:25"
  },
  {
    "id": 280,
    "tamil": "ஒருவருக்கொருவர் மன்னியுங்கள் ஸ்தோத்திரம்.",
    "ref": "எபே. 4:32"
  },
  {
    "id": 281,
    "tamil": "ஒருவருக்கொருவர் கீழ்படிந்திருங்கள் ஸ்தோத்திரம்.",
    "ref": "எபே. 5:21"
  },
  {
    "id": 282,
    "tamil": "ஒருவருக்கொருவர் பொறாமை கொள்ளாதிருங்கள் ஸ்தோத்திரம்.",
    "ref": "கலாத். 5:26"
  },
  {
    "id": 283,
    "tamil": "ஒருவருக்கொருவர் விரோதமாய் பேசாதிருங்கள் ஸ்தோத்திரம்.",
    "ref": "யாக். 4:11"
  },
  {
    "id": 284,
    "tamil": "ஒருவருக்கொருவர் அநியாயம் செய்யாதிருங்கள் ஸ்தோத்திரம்.",
    "ref": "அப். 7:26"
  },
  {
    "id": 285,
    "tamil": "ஒருவருக்கொருவர் குற்றங்கள் அறிக்கையிடுங்கள் ஸ்தோத்திரம்.",
    "ref": "யாக். 5:16"
  },
  {
    "id": 286,
    "tamil": "ஒருவருக்கொருவர் தயவாயும், மனஉருக்கமாயுமிருங்கள் ஸ்தோத்திரம்.",
    "ref": "எபே. 4:32"
  },
  {
    "id": 287,
    "tamil": "ஒருவரோடொருவர் சமாதானமாயிருங்கள் ஸ்தோத்திரம்.",
    "ref": "மாற்கு 9:50"
  },
  {
    "id": 288,
    "tamil": "ஒருவரோடொருவர் ஐக்கியமாயிருங்கள் ஸ்தோத்திரம்.",
    "ref": "1 யோவா. 1:7"
  },
  {
    "id": 289,
    "tamil": "ஓங்கிய புயத்தினால் ஆள்பவரே ஸ்தோத்திரம்.",
    "ref": "எசேக். 20:33"
  },
  {
    "id": 290,
    "tamil": "ஓய்வுநாளை பரிசுத்த நாளாய் நியமித்தவரே ஸ்தோத்திரம்.",
    "ref": "யாத். 20:8"
  },
  {
    "id": 291,
    "tamil": "ஓங்கிய புயத்தினால் இஸ்ரவேலை புறப்பட பண்ணினவரே ஸ்தோத்திரம்.",
    "ref": "உபா. 9:29"
  },
  {
    "id": 292,
    "tamil": "ஓசையுள்ள கைத்தாளத்துடன் துதிக்க வைத்தவரே ஸ்தோத்திரம்.",
    "ref": "சங். 150:5"
  },
  {
    "id": 293,
    "tamil": "ஓசன்னா, இஸ்ரவேலின் ராஜா ஸ்தோத்தரிக்கப்பட்டவர் ஸ்தோத்திரம்.",
    "ref": "யோவா. 12:13"
  },
  {
    "id": 294,
    "tamil": "ஔஷதம் சொஸ்தமாக்கும் ஸ்தோத்திரம்.",
    "ref": "எரே. 30:13"
  },
  {
    "id": 295,
    "tamil": "ஔஷதம் உண்மையுள்ள ஸ்தானாதிபதியை குறிக்கும் ஸ்தோத்திரம்.",
    "ref": "நீதி. 13:17"
  },
  {
    "id": 296,
    "tamil": "ஔஷதம் ஞானமுள்ளவரின் நாவு ஸ்தோத்திரம்.",
    "ref": "நீதி. 12:18"
  },
  {
    "id": 297,
    "tamil": "ஔஷதம் மனமகிழ்ச்சி ஸ்தோத்திரம்.",
    "ref": "நீதி. 17:22"
  },
  {
    "id": 298,
    "tamil": "கர்த்தர் பெரியவர் ஸ்தோத்திரம்.",
    "ref": "சங். 48:1"
  },
  {
    "id": 299,
    "tamil": "கர்த்தர் நீதியுள்ளவர் ஸ்தோத்திரம்.",
    "ref": "சங். 11:7"
  },
  {
    "id": 300,
    "tamil": "கர்த்தர் நியாயாதிபதி ஸ்தோத்திரம்.",
    "ref": "1 சாமு. 24:15"
  }
]